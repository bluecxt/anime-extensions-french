{
  "name": "Anime-Sama Suite",
  "extension": "eu.kanade.tachiyomi.animeextension.fr.animesama.AnimeSama",
  "lang": "fr",
  "tests": [
    {
      "name": "Anime-Sama Popular Catalog Check",
      "target": "GET_POPULAR",
      "input": {
        "page": 1
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "Anime-Sama Search 'Naruto' Check",
      "target": "GET_SEARCH",
      "input": {
        "page": 1,
        "query": "Naruto"
      },
      "contract": {
        "minCount": 1,
        "allThumbnailsNonNull": true,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "AnimeSama Details Check",
      "target": "GET_DETAILS",
      "input": {
        "anime": {
          "title": "Naruto",
          "url": "{\"url\":\"/catalogue/naruto\",\"titles\":[\"Naruto\"]}"
        }
      },
      "contract": {
        "requireNonBlankFields": [
          "description",
          "thumbnail_url"
        ]
      }
    },
    {
      "name": "AnimeSama Season List Check",
      "target": "GET_SEASON_LIST",
      "input": {
        "anime": {
          "title": "Naruto",
          "url": "{\"url\":\"/catalogue/naruto\",\"titles\":[\"Naruto\"]}"
        }
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
