{
  "name": "Anime-Sama Suite",
  "extension": "eu.kanade.tachiyomi.animeextension.fr.animesama.AnimeSama",
  "lang": "fr",
  "tests": [
    {
      "name": "Anime-Sama Popular Catalog Check",
      "target": "GET_POPULAR",
      "input": {
        "page": 1
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "Anime-Sama Search 'Naruto' Check",
      "target": "GET_SEARCH",
      "input": {
        "page": 1,
        "query": "Naruto"
      },
      "contract": {
        "minCount": 1,
        "allThumbnailsNonNull": true,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "AnimeSama Details Check",
      "target": "GET_DETAILS",
      "input": {
        "anime": {
          "title": "Naruto",
          "url": "{\"url\":\"/catalogue/naruto\",\"titles\":[\"Naruto\"]}"
        }
      },
      "contract": {
        "requireNonBlankFields": [
          "description",
          "thumbnail_url"
        ]
      }
    },
    {
      "name": "AnimeSama Season List Check",
      "target": "GET_SEASON_LIST",
      "input": {
        "anime": {
          "title": "Naruto",
          "url": "{\"url\":\"/catalogue/naruto\",\"titles\":[\"Naruto\"]}"
        }
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "AnimeSama Episode List Check",
      "target": "GET_EPISODE_LIST",
      "input": {
        "anime": {
          "title": "Naruto",
          "url": "{\"url\":\"/catalogue/naruto/saison1\",\"titles\":[\"Naruto\"],\"season\":\"saison1\"}"
        }
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "name",
          "url"
        ]
      }
    },
    {
      "name": "AnimeSama Related Anime Check",
      "target": "FETCH_RELATED",
      "input": {
        "anime": {
          "title": "Naruto",
          "url": "{\"url\":\"/catalogue/naruto\",\"titles\":[\"Naruto\"]}"
        }
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "AnimeSama Hoster List Check",
      "target": "GET_HOSTER_LIST",
      "input": {
        "episode": {
          "name": "Épisode 1",
          "url": "[{\"url\":\"https://ansembed.net/embed-1b8gwch0weq4.html\",\"lang\":\"vostfr\"},{\"url\":\"https://uqload.vc/embed-21p39c78a0zf.html\",\"lang\":\"vostfr\"}]"
        }
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "name"
        ]
      }
    },
    {
      "name": "AnimeSama Video List Check",
      "target": "GET_VIDEO_LIST",
      "input": {
        "hoster": {
          "hosterName": "VOSTFR",
          "internalData": "[{\"url\":\"https://ansembed.net/embed-1b8gwch0weq4.html\",\"lang\":\"vostfr\"}]"
        }
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "url"
        ]
      }
    }
  ]
}