{
  "name": "PapaDuStream Suite",
  "extension": "eu.kanade.tachiyomi.animeextension.fr.papadustream.PapaDuStream",
  "lang": "fr",
  "tests": [
    {
      "name": "PapaDuStream Popular Catalog Check",
      "target": "GET_POPULAR",
      "input": {
        "page": 1
      },
      "contract": {
        "minCount": 1,
        "allThumbnailsNonNull": true,
        "urlPattern": "^/cat-series/.+\\.html$",
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "PapaDuStream Search 'Piece' Check",
      "target": "GET_SEARCH",
      "input": {
        "page": 1,
        "query": "Piece"
      },
      "contract": {
        "minCount": 1,
        "urlPattern": "^/cat-series/.+\\.html$",
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "PapaDuStream Search Filter 'Animation' Check",
      "target": "GET_SEARCH",
      "input": {
        "page": 1,
        "query": "",
        "filters": {
          "Catégorie": "Animation"
        }
      },
      "contract": {
        "minCount": 1,
        "allThumbnailsNonNull": true,
        "urlPattern": "^/cat-series/.+\\.html$",
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "PapaDuStream Details Check",
      "target": "GET_DETAILS",
      "input": {
        "anime": {
          "title": "Rick et Morty",
          "url": "/cat-series/animation-s/856-rick-et-morty.html"
        }
      },
      "contract": {
        "requireNonBlankFields": [
          "description",
          "thumbnail_url"
        ]
      }
    },
    {
      "name": "PapaDuStream Season List Check",
      "target": "GET_SEASON_LIST",
      "input": {
        "anime": {
          "title": "Rick et Morty",
          "url": "/cat-series/animation-s/856-rick-et-morty.html"
        }
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "PapaDuStream Episode List Check",
      "target": "GET_EPISODE_LIST",
      "input": {
        "anime": {
          "title": "Rick et Morty",
          "url": "/cat-series/animation-s/856-rick-et-morty/1-saison.html"
        }
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "name",
          "url"
        ]
      }
    },
    {
      "name": "PapaDuStream Hoster List Check",
      "target": "GET_HOSTER_LIST",
      "input": {
        "episode": {
          "name": "Épisode 1 - Pilot",
          "url": "/cat-series/animation-s/856-rick-et-morty/1-saison/1-episode.html"
        }
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "name"
        ]
      }
    }
  ]
}